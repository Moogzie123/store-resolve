{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vite.worker.config.ts",
    "eslint.config.js",
    "playwright.config.ts",
    "worker",
    "worker-configuration.d.ts",
    "src/lib"
  ]
}
