{
  "name": "store-resolve",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --var DEV_AUTH_USER_ID:father",
    "dev:web": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "build:worker": "vite build --config vite.worker.config.ts --configLoader runner",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --configLoader runner",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply store-resolve --local",
    "db:migrate:remote": "wrangler d1 migrations apply store-resolve --remote",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.2",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.4",
    "lucide-react": "^0.539.0",
    "miniflare": "^4.20250906.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.66",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.28.1"
  }
}
